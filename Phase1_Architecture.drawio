<mxfile host="app.diagrams.net">
  <diagram name="Architecture" id="arch1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="dev" value="Developer (Cloud9 / EC2 dev environment)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="repo" value="Source repo&#xa;(CodeCommit / GitHub)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="60" width="140" height="70" as="geometry"/></mxCell>
        <mxCell id="pipe" value="AWS CodePipeline" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="60" width="140" height="70" as="geometry"/></mxCell>
        <mxCell id="build" value="CodeBuild&#xa;(docker build + push)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="610" y="60" width="140" height="70" as="geometry"/></mxCell>
        <mxCell id="ecr" value="Amazon ECR&#xa;customer / employee repos" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="deploy" value="CodeDeploy&#xa;(blue/green)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1020" y="60" width="140" height="70" as="geometry"/></mxCell>
        <mxCell id="iam" value="IAM roles" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1200" y="60" width="120" height="70" as="geometry"/></mxCell>
        <mxCell id="vpc" value="VPC (ap-southeast-2) - 2 public subnets across 2 AZs" style="rounded=1;dashed=1;fillColor=none;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="1300" height="620" as="geometry"/></mxCell>
        <mxCell id="user" value="Users (browser)" style="shape=actor;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="60" height="80" as="geometry"/></mxCell>
        <mxCell id="alb" value="Application Load Balancer&#xa;HTTP :80 (prod) / :8080 (test)&#xa;/ and /suppliers -> Customer&#xa;/admin* -> Employee" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="180" y="420" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="tg1" value="TG customer-blue" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="480" y="260" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="tg2" value="TG customer-green" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="480" y="330" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="tg3" value="TG employee-blue" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="480" y="580" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="tg4" value="TG employee-green" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="480" y="650" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="ecs" value="Amazon ECS cluster (Fargate)" style="rounded=1;dashed=1;fillColor=none;strokeColor=#d79b00;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="680" y="230" width="360" height="500" as="geometry"/></mxCell>
        <mxCell id="cust" value="Customer microservice&#xa;ECS service + tasks (read-only list)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="290" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="emp" value="Employee microservice&#xa;ECS service + tasks (add/edit/delete)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="580" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="rds" value="Amazon RDS MySQL&#xa;(suppliers DB)" style="shape=cylinder3;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1110" y="420" width="130" height="120" as="geometry"/></mxCell>
